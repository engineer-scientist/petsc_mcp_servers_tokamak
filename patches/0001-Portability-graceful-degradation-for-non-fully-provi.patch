From 5bacb4df0933d4c46067295602297360b79620c9 Mon Sep 17 00:00:00 2001
From: Sarthak Sharma <sarthak.sharma@anl.gov>
Date: Thu, 23 Jul 2026 10:57:17 -0500
Subject: [PATCH 1/4] Portability + graceful degradation for
 non-fully-provisioned hosts

- generateServer(): spawn stdio sub-servers with sys.executable instead of a
  hardcoded python3.13 (works on hosts with a different Python, e.g. 3.12).
- petscmcp: add documentationAvailable()/ragAvailable() probes.
- code-generator server: include only sub-servers that can run here (compile-run
  always; documentation only if docs built; RAG only if NVIDIA_API_KEY set), and
  report the true server count in the prompt so the agent doesn't bail.

Enables the code-generation + orchestrator agents to run on a compute node where
the PETSc docs and RAG corpus are not provisioned.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 petsc_claude_code_generator_mcp_server.py | 15 ++++++++++++---
 petscmcp.py                               | 18 +++++++++++++++++-
 2 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/petsc_claude_code_generator_mcp_server.py b/petsc_claude_code_generator_mcp_server.py
index 5b99764..c0f05a8 100644
--- a/petsc_claude_code_generator_mcp_server.py
+++ b/petsc_claude_code_generator_mcp_server.py
@@ -18,9 +18,18 @@ mcp = fastmcp.server.FastMCP("PETSc Claude-based code generator MCP server", ins
 
 async def generate_code_async(specification: str) -> dict:
   '''Generates code based on specification'''
-  # Add here a check that the tool is running properly before passing to Claude
+  # Include only the sub-servers that can actually run on this host. The compile-run
+  # server is always required; documentation needs built docs and RAG needs an NVIDIA
+  # key + corpus, both of which may be absent (e.g. on a compute node). Advertising a
+  # server whose tools error would make the inner Claude give up, so we omit them.
+  sub_servers = {'PETSc compiler-run': petscmcp.generateServer('compile_run')}
+  if petscmcp.documentationAvailable():
+    sub_servers['PETSc documentation'] = petscmcp.generateServer('documentation')
+  if petscmcp.ragAvailable():
+    sub_servers['PETSc RAG'] = petscmcp.generateServer('rag')
+  petscmcp.log('Code generator using sub-servers: ' + str(list(sub_servers.keys())) + '\n')
   _opts = {
-    'mcp_servers': {'PETSc compiler-run': petscmcp.generateServer('compile_run'), 'PETSc documentation': petscmcp.generateServer('documentation'), 'PETSc RAG': petscmcp.generateServer('rag')},
+    'mcp_servers': sub_servers,
     'allowed_tools': ["mcp__PETSc*"],
     'permission_mode': "bypassPermissions",
   }
@@ -32,7 +41,7 @@ async def generate_code_async(specification: str) -> dict:
   tool_cnt = 0
   async with claude_agent_sdk.ClaudeSDKClient(options = options) as client:
     results = {}
-    query = 'Write and compile a PETSc for me that ' + specification + ' using the PETSc compile-run MCP server available to you. Do **not** use the Bash or Write tool! Verify you have access to three MCP servers, if you do not then exit immediately. Always use the latest PETSc coding style which wraps the PETSc function calls inside the PetscCall() macro and does not use the old ierr = approach. Do not use %D as a formatting argument in printf() and related calls. Once the code compiles and runs return the code and its output as a JSON dictionary with two keys, code and output in a TextBlock'
+    query = 'Write and compile a PETSc for me that ' + specification + ' using the PETSc compile-run MCP server available to you. Do **not** use the Bash or Write tool! Verify you have access to the PETSc compile-run MCP server (there are ' + str(len(sub_servers)) + ' MCP server(s) available to you); if you do not have the compile-run server then exit immediately. Always use the latest PETSc coding style which wraps the PETSc function calls inside the PetscCall() macro and does not use the old ierr = approach. Do not use %D as a formatting argument in printf() and related calls. Once the code compiles and runs return the code and its output as a JSON dictionary with two keys, code and output in a TextBlock'
     while not results:
       await client.query(query)
       async for message in client.receive_response():
diff --git a/petscmcp.py b/petscmcp.py
index cc6b1ea..736ef57 100644
--- a/petscmcp.py
+++ b/petscmcp.py
@@ -533,7 +533,9 @@ def generateServer(servername: str, url: str = None, port: int = None) -> dict:
   if not port: port = sport
 
   if script and 'PETSC_MCP_SERVERS_STDIO' in os.environ:
-    server = {'command': 'python3.13', 'args': [script, '--stdio']}
+    # Use the running interpreter rather than a hardcoded 'python3.13' so the stdio
+    # spawn works on hosts that ship a different Python (e.g. 3.12 on ANL CELS GCE).
+    server = {'command': sys.executable, 'args': [script, '--stdio']}
   else:
     if url:
       url = ProcessURL(url, port)
@@ -575,6 +577,20 @@ def ProcessMarkdown(text):
   #print('$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$')
   return text
 
+def documentationAvailable() -> bool:
+  '''True if the PETSc documentation server can start here, i.e. the docs were built
+     ($PETSC_DIR/$PETSC_ARCH-doc/manualpages/htmlmap exists). The docs are produced by
+     `make alldoc` and are often absent on compute nodes.'''
+  petsc_dir  = os.environ.get('PETSC_DIR')
+  petsc_arch = os.environ.get('PETSC_ARCH')
+  if not petsc_dir or not petsc_arch: return False
+  return os.path.isfile(os.path.join(petsc_dir, petsc_arch + '-doc', 'manualpages', 'htmlmap'))
+
+def ragAvailable() -> bool:
+  '''True if the PETSc RAG server can be used here, i.e. an NVIDIA_API_KEY is set.
+     (The RAG server also needs the rag-data corpus and langchain deps.)'''
+  return bool(os.environ.get('NVIDIA_API_KEY'))
+
 def serverCheckKey(key):
   '''Checks if a variable is in the environment and exits the problem if it is not'''
   if not key in os.environ:
