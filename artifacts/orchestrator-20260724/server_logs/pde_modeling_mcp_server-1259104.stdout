# UFL / FEniCS representation of the Grad-Shafranov equilibrium equation
# (Solov'ev linear source model) on a rectangular (R,Z) cross-section.
#
# Strong form:   R d/dR( (1/R) dpsi/dR ) + d^2 psi/dZ^2 = -(C1 R^2 + C2)
# Divide by R:   div( (1/R) grad psi ) = -(C1 R + C2/R)
# Weak form:     integral (1/R) grad(psi).grad(v) dx = integral (C1 R + C2/R) v dx
#
# Coordinates: x[0] = R (major radius), x[1] = Z (height).

from dolfin import (RectangleMesh, Point, FunctionSpace, TrialFunction,
                    TestFunction, SpatialCoordinate, Constant, DirichletBC,
                    Function, solve)
from ufl import inner, grad, dx

# --- Mesh over the rectangular (R,Z) cross-section domain Omega ---
R_min, R_max = 0.5, 1.5   # keep R > 0 (axisymmetric domain)
Z_min, Z_max = -1.0, 1.0
nx, ny = 64, 64
mesh = RectangleMesh(Point(R_min, Z_min), Point(R_max, Z_max), nx, ny)

# --- Function space ---
V = FunctionSpace(mesh, "P", 1)

# --- Trial / test functions ---
psi = TrialFunction(V)   # unknown poloidal flux psi(R,Z)
v   = TestFunction(V)

# --- Spatial coordinates: R = x[0], Z = x[1] ---
x = SpatialCoordinate(mesh)
R = x[0]

# --- Solov'ev source constants (mu0*dp/dpsi = C1, F*dF/dpsi = C2) ---
C1 = Constant(1.0)
C2 = Constant(1.0)

# --- Bilinear and linear forms (weak form) ---
a = (1.0 / R) * inner(grad(psi), grad(v)) * dx
L = (C1 * R + C2 / R) * v * dx

# --- Dirichlet boundary condition: psi = 0 on the plasma boundary ---
def boundary(x, on_boundary):
    return on_boundary

bc = DirichletBC(V, Constant(0.0), boundary)

# --- Solve the linear elliptic problem ---
psi_h = Function(V)
solve(a == L, psi_h, bc)

